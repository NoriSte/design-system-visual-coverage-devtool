{
    "name": "@noriste/ds-visual-coverage-devtool-common",
    "version": "1.2.1",
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "main": "dist/index.js",
    "files": [
        "dist/"
    ],
    "sideEffects": false,
    "browserslist": "last 2 versions",
    "scripts": {
        "clean": "rm -rf dist",
        "test": "yarn check:types && yarn test:browser",
        "check:types": "run --top-level tsc --noEmit",
        "test:browser": "run --top-level vitest --config=browser.vitest.config.ts --run",
        "test:browser:watch": "run --top-level vitest --config=browser.vitest.config.ts --browser.headless",
        "test:browser:watch:ui": "run --top-level vitest --config=browser.vitest.config.ts",
        "build": "NODE_ENV=production && run build:rollup",
        "build:rollup": "run --top-level rollup -c rollup.config.cjs",
        "dev": "run build:rollup -w"
    },
    "peerDependencies": {
        "@noriste/ds-visual-coverage-core": "1.2.1",
        "@noriste/ds-visual-coverage-preply": "1.2.1",
        "@noriste/ds-visual-coverage-rn": "1.2.1",
        "react": "^16 || ^18"
    },
    "gitHead": "43a57736ab7534349a8a7224e2ae426110af95cc",
    "devDependencies": {
        "@noriste/ds-visual-coverage-core": "workspace:*",
        "@noriste/ds-visual-coverage-preply": "workspace:*",
        "@noriste/ds-visual-coverage-rn": "workspace:*",
        "@vitest/coverage-istanbul": "^3.0.4",
        "react": "^18.2.0"
    }
}
